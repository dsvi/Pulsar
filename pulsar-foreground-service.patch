diff --git a/app/src/main/java/com/ds/pulsar/PulseService.kt b/app/src/main/java/com/ds/pulsar/PulseService.kt
new file mode 100644
index 0000000..d400d26
--- /dev/null
+++ b/app/src/main/java/com/ds/pulsar/PulseService.kt
@@ -0,0 +1,209 @@
+package com.ds.pulsar
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Typeface
+import android.os.Build
+import android.os.IBinder
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.graphics.drawable.IconCompat
+import com.beepiz.bluetooth.gattcoroutines.ConnectionClosedException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.launch
+import java.util.concurrent.TimeoutException
+
+/** Latest values, shared between the service and the UI. */
+object PulseState {
+    val pulse = MutableStateFlow("---")
+    val battery = MutableStateFlow("")
+}
+
+/**
+ * Foreground service that owns the BLE connection, so it survives
+ * switching apps, and shows the current BPM in the status bar.
+ */
+@OptIn(com.beepiz.bluetooth.gattcoroutines.ExperimentalBleGattCoroutinesCoroutinesApi::class)
+class PulseService : Service() {
+
+    companion object {
+        const val ACTION_STOP = "ds.pulsar.STOP"
+        private const val CHANNEL_ID = "pulse_v2"
+        private const val NOTIF_ID = 1
+
+        fun start(ctx: Context) {
+            androidx.core.content.ContextCompat.startForegroundService(
+                ctx, Intent(ctx, PulseService::class.java)
+            )
+        }
+
+        fun stop(ctx: Context) {
+            ctx.stopService(Intent(ctx, PulseService::class.java))
+        }
+    }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+    private var connectionJob: Job? = null
+    private var jobGeneration = -1
+    private var lastShown: String? = null
+    private lateinit var nm: NotificationManager
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onCreate() {
+        super.onCreate()
+        nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            nm.createNotificationChannel(
+                NotificationChannel(CHANNEL_ID, "Heart rate", NotificationManager.IMPORTANCE_LOW)
+                    .apply {
+                        setShowBadge(false)
+                        lockscreenVisibility = Notification.VISIBILITY_PUBLIC
+                    }
+            )
+        }
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == ACTION_STOP) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        ServiceCompat.startForeground(
+            this, NOTIF_ID, buildNotification(PulseState.pulse.value),
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
+                ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE else 0
+        )
+        // (Re)start the connection if not running, or if another device was picked.
+        if (connectionJob?.isActive != true || jobGeneration != heartRateStream.generation) {
+            connectionJob?.cancel()
+            jobGeneration = heartRateStream.generation
+            connectionJob = scope.launch { connectionLoop() }
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onDestroy() {
+        scope.cancel()
+        PulseState.pulse.value = "---"
+        super.onDestroy()
+    }
+
+    private suspend fun connectionLoop() {
+        while (true) {
+            try {
+                coroutineScope {
+                    PulseState.pulse.value = "---"
+                    updateNotification("---")
+                    heartRateStream.heartRateFlow().collect {
+                        val p = it.pulse.toString()
+                        PulseState.pulse.value = p
+                        if (it.batteryLevel != null)
+                            PulseState.battery.value = it.batteryLevel.toString() + "%"
+                        updateNotification(p)
+                    }
+                }
+            } catch (e: Exception) {
+                if (e is CancellationException && e !is ConnectionClosedException) throw e
+                if (e !is TimeoutException) {
+                    println("Error collecting data from device: $e")
+                    e.printStackTrace()
+                }
+            }
+            println("retrying to connect")
+            delay(200)
+        }
+    }
+
+    private fun updateNotification(text: String) {
+        if (text == lastShown) return
+        lastShown = text
+        nm.notify(NOTIF_ID, buildNotification(text))
+    }
+
+    private fun buildNotification(text: String): Notification {
+        val open = PendingIntent.getActivity(
+            this, 0,
+            Intent(this, MainActivity::class.java)
+                .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+        )
+        val stop = PendingIntent.getService(
+            this, 1,
+            Intent(this, PulseService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+        )
+        return NotificationCompat.Builder(this, CHANNEL_ID)
+            .setSmallIcon(IconCompat.createWithBitmap(numberIcon(text)))
+            .setContentTitle(if (text == "---") "♥ Searching…" else "♥ $text bpm")
+            .setContentIntent(open)
+            .addAction(0, "Stop", stop)
+            .setOngoing(true)
+            .setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
+            .setOnlyAlertOnce(true)
+            .setShowWhen(false)
+            .setCategory(NotificationCompat.CATEGORY_SERVICE)
+            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)
+            .build()
+    }
+
+    /** Status bar icons are monochrome: a white heart left of the number, on transparent. */
+    private fun numberIcon(text: String): Bitmap {
+        val h = 96
+        val digitH = 90f // digits fill almost the full icon height, so they render large
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.WHITE
+            typeface = Typeface.create("sans-serif-condensed", Typeface.BOLD)
+            textAlign = Paint.Align.LEFT
+            textSize = 100f
+        }
+        // scale the text so a digit is exactly digitH pixels tall
+        val b = android.graphics.Rect()
+        paint.getTextBounds("0", 0, 1, b)
+        paint.textSize = 100f * digitH / b.height()
+
+        val heartH = 78f
+        val heartW = 84f
+        val gap = 6f
+        val textW = paint.measureText(text)
+        val w = (heartW + gap + textW).toInt() + 2
+        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        val c = Canvas(bmp)
+
+        // heart
+        val top = (h - heartH) / 2f
+        fun x(v: Float) = v * heartW
+        fun y(v: Float) = top + v * heartH
+        val path = android.graphics.Path().apply {
+            moveTo(x(0.5f), y(0.95f))
+            cubicTo(x(0.05f), y(0.60f), x(0.00f), y(0.20f), x(0.25f), y(0.08f))
+            cubicTo(x(0.40f), y(0.00f), x(0.50f), y(0.12f), x(0.50f), y(0.25f))
+            cubicTo(x(0.50f), y(0.12f), x(0.60f), y(0.00f), x(0.75f), y(0.08f))
+            cubicTo(x(1.00f), y(0.20f), x(0.95f), y(0.60f), x(0.50f), y(0.95f))
+            close()
+        }
+        c.drawPath(path, paint)
+
+        // number: baseline so the digits are vertically centered
+        c.drawText(text, heartW + gap, h / 2f + digitH / 2f, paint)
+        return bmp
+    }
+}
